{
  "name": "dnd-api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "nodemon -w src/server -x tsx src/server/main.ts",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "build": "vite build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:full": "tsx prisma/seed-full.ts",
    "db:seed:adventures": "tsx prisma/seed-adventures.ts",
    "db:seed:items": "tsx prisma/seed-items.ts",
    "db:fetch:npc-wiki": "tsx prisma/fetch-npc-wiki.ts",
    "db:seed:elasticsearch": "tsx prisma/seed-elasticsearch.ts",
    "db:reset": "prisma migrate reset --force",
    "db:format": "prisma format",
    "db:stats": "tsx prisma/seed-full.ts --stats",
    "db:clear": "tsx -e \"import prisma from './src/lib/prisma'; import { clearAllTables } from './src/lib/migration'; clearAllTables().then(() => prisma.$disconnect())\""
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.10",
    "tsx": "^4.19.3",
    "vite": "^6.3.3"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite-express": "*"
  }
}
