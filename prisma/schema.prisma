// D&D Toolkit Prisma Schema
// PostgreSQL Database Schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// LOOKUP / REFERENCE TABLES
// ============================================================================

model Book {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  type      String? // core, expansion, adventure
  createdAt DateTime @default(now())

  adventures Adventure[]

  @@map("book")
}

model Adventure {
  id         String    @id @default(uuid())
  code       String    @unique // e.g. "LMoP", "TftYP-AtG"
  name       String
  storyline  String?
  levelStart Int?      @map("level_start")
  levelEnd   Int?      @map("level_end")
  published  DateTime?
  bookId     String?   @map("book_id")
  createdAt  DateTime  @default(now())

  book     Book?              @relation(fields: [bookId], references: [id])
  sections AdventureSection[]
  npcs     Npc[]

  @@map("adventure")
}

model AdventureSection {
  id          String @id @default(uuid())
  adventureId String @map("adventure_id")
  ordinal     Int // chapter order within the adventure
  name        String
  headers     Json? // table-of-contents headers for this chapter
  entries     Json // full nested entry tree (text, insets, tables, images)
  images      Json? // extracted image refs: [{ title, path, url }]

  adventure Adventure      @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  maps      AdventureMap[]

  @@unique([adventureId, ordinal])
  @@map("adventure_section")
}

model AdventureMap {
  id        String @id @default(uuid())
  sectionId String @map("section_id")
  name      String
  imagePath String @map("image_path") // player-facing (unlabeled) variant
  ordinal   Int    @default(0)

  section AdventureSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  pins    AdventureMapPin[]

  @@unique([sectionId, name])
  @@map("adventure_map")
}

model AdventureMapPin {
  id        String @id @default(uuid())
  mapId     String @map("map_id")
  label     String // printed/assigned marker text, e.g. "1", "E1", "2a"
  entryName String @map("entry_name") // exact heading text in the section's entries tree
  // Null until the pin is placed on the image. Location lists are generated for
  // every adventure from the printed numbered headings, but the coordinates are
  // hand-authored, so an unplaced pin still lists/links its text — it just
  // doesn't render an overlay marker.
  x         Float? // percent 0-100, relative to image width
  y         Float? // percent 0-100, relative to image height

  map AdventureMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  // Some printed maps repeat a label for two symmetric rooms sharing one
  // description (e.g. Cragmaw Castle's twin "3. Archer Post" towers), so
  // uniqueness includes position rather than label alone.
  @@unique([mapId, label, x, y])
  @@map("adventure_map_pin")
}

model Npc {
  id          String  @id @default(uuid())
  name        String
  source      String // source book code the creature tag points at
  adventureId String  @map("adventure_id")
  monsterId   String? @map("monster_id")
  tokenUrl    String? @map("token_url")
  appearance  String? // physical description: race, age, clothing, features
  location    String? // where the NPC is found, e.g. "Stonehill Inn — Phandalin"
  description String? // who they are: role, affiliations, motivations

  adventure Adventure   @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  monster   Monster?    @relation(fields: [monsterId], references: [id])
  users     NpcToUser[]

  @@unique([adventureId, name])
  @@index([monsterId])
  @@map("npc")
}

model Language {
  id   String @id @default(uuid())
  name String @unique

  raceLanguages       RaceLanguage[]
  backgroundLanguages BackgroundLanguage[]

  @@map("language")
}

model AbilityScore {
  id           String @id @default(uuid())
  abbreviation String @unique
  name         String

  skills Skill[]

  @@map("ability_score")
}

model Alignment {
  id   String @id @default(uuid())
  code String @unique
  name String

  @@map("alignment")
}

model DamageType {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  @@map("damage_type")
}

model SchoolOfMagic {
  id           String @id @default(uuid())
  name         String @unique
  abbreviation String

  @@map("school_of_magic")
}

model Skill {
  id            String       @id @default(uuid())
  name          String       @unique
  abilityScore  AbilityScore @relation(fields: [ability_score], references: [abbreviation])
  ability_score String
  description   String?

  @@map("skill")
}

// ============================================================================
// USERS / AUTH
// ============================================================================

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  name         String?
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  spells        SpellToUser[]
  items         ItemToUser[]
  monsters      MonsterToUser[]
  npcs          NpcToUser[]
  parties       Party[]
  characters    Character[]
  encounters    Encounter[]
  refreshTokens RefreshToken[]

  @@map("app_user")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model SpellToUser {
  id        String   @id @default(uuid())
  spellId   String   @map("spell_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())

  spell Spell @relation(fields: [spellId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spellId, userId])
  @@map("spell_to_user")
}

model ItemToUser {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@map("item_to_user")
}

model MonsterToUser {
  id        String   @id @default(uuid())
  monsterId String   @map("monster_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([monsterId, userId])
  @@map("monster_to_user")
}

model NpcToUser {
  id        String   @id @default(uuid())
  npcId     String   @map("npc_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())

  npc  Npc  @relation(fields: [npcId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([npcId, userId])
  @@map("npc_to_user")
}

// ============================================================================
// CORE GAME CONTENT
// ============================================================================

model Race {
  id          String   @id @default(uuid())
  name        String
  source      String
  page        Int?
  size        String? // S, M, L, H, G
  speed       Int      @default(30)
  darkvision  Int?
  speedFly    Int?     @map("speed_fly")
  speedSwim   Int?     @map("speed_swim")
  strBonus    Int?     @map("str_bonus")
  dexBonus    Int?     @map("dex_bonus")
  conBonus    Int?     @map("con_bonus")
  intBonus    Int?     @map("int_bonus")
  wisBonus    Int?     @map("wis_bonus")
  chaBonus    Int?     @map("cha_bonus")
  description Json?
  createdAt   DateTime @default(now())

  subraces      Subrace[]
  raceLanguages RaceLanguage[]
  characters    Character[]

  @@unique([name, source])
  @@map("race")
}

model RaceLanguage {
  raceId     String
  languageId String
  race       Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  language   Language @relation(fields: [languageId], references: [id])

  @@id([raceId, languageId])
  @@map("race_language")
}

model Subrace {
  id             String   @id @default(uuid())
  raceId         String
  name           String
  source         String?
  page           Int?
  abilityBonuses Json?
  description    Json?
  createdAt      DateTime @default(now())

  race       Race        @relation(fields: [raceId], references: [id], onDelete: Cascade)
  characters Character[]

  @@unique([raceId, name])
  @@map("subrace")
}

model Class {
  id             String   @id @default(uuid())
  name           String   @unique
  source         String
  hitDie         Int      @map("hit_die")
  proficiencyStr Boolean  @default(false) @map("proficiency_str")
  proficiencyDex Boolean  @default(false) @map("proficiency_dex")
  proficiencyCon Boolean  @default(false) @map("proficiency_con")
  proficiencyInt Boolean  @default(false) @map("proficiency_int")
  proficiencyWis Boolean  @default(false) @map("proficiency_wis")
  proficiencyCha Boolean  @default(false) @map("proficiency_cha")
  subclassTitle  String?  @map("subclass_title")
  description    Json?
  createdAt      DateTime @default(now())

  features   ClassFeature[]
  subclasses Subclass[]
  spells     SpellClass[]
  characters Character[]

  @@map("class")
}

model ClassFeature {
  id                  String   @id @default(uuid())
  classId             String
  name                String
  level               Int
  description         Json
  gainSubclassFeature Boolean  @default(false) @map("gain_subclass_feature")
  createdAt           DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("class_feature")
}

model Subclass {
  id          String   @id @default(uuid())
  classId     String
  name        String
  shortName   String?  @map("short_name")
  source      String
  description Json?
  createdAt   DateTime @default(now())

  class          Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  features       SubclassFeature[]
  characters     Character[]
  spellClassFrom SpellClass[]      @relation("FromSubclass")

  @@unique([classId, name])
  @@map("subclass")
}

model SubclassFeature {
  id          String   @id @default(uuid())
  subclassId  String
  name        String
  level       Int
  description Json
  createdAt   DateTime @default(now())

  subclass Subclass @relation(fields: [subclassId], references: [id], onDelete: Cascade)

  @@map("subclass_feature")
}

model Spell {
  id                  String   @id @default(uuid())
  name                String
  source              String
  level               Int
  school              String?  @map("school")
  castingTime         Json     @map("casting_time")
  range               Json
  components          Json
  materialDescription String?  @map("material_description")
  duration            Json
  concentration       Boolean  @default(false)
  ritual              Boolean  @default(false)
  description         Json
  higherLevel         Json?    @map("higher_level")
  damageType          String?  @map("damage_type")
  savingThrow         String?  @map("saving_throw")
  page                Int?
  createdAt           DateTime @default(now())

  classes         SpellClass[]
  characterSpells CharacterSpell[]
  monsters        MonsterSpell[]
  users           SpellToUser[]

  @@unique([name, source])
  @@map("spell")
}

model SpellClass {
  id           String    @id @default(uuid())
  spellId      String
  classId      String
  fromSubclass Boolean   @default(false) @map("from_subclass")
  subclassId   String?
  spell        Spell     @relation(fields: [spellId], references: [id], onDelete: Cascade)
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subclass     Subclass? @relation("FromSubclass", fields: [subclassId], references: [id], onDelete: SetNull)

  @@unique([spellId, classId, subclassId])
  @@map("spell_class")
}

model Condition {
  id          String   @id @default(uuid())
  name        String   @unique
  source      String
  description Json
  page        Int?
  createdAt   DateTime @default(now())

  @@map("condition")
}

model Background {
  id                 String   @id @default(uuid())
  name               String   @unique
  source             String
  skillProficiencies Json?    @map("skill_proficiencies")
  toolProficiencies  Json?    @map("tool_proficiencies")
  languages          Json?
  startingGold       Int?     @map("starting_gold")
  featureName        String?  @map("feature_name")
  featureDescription Json?    @map("feature_description")
  suggestedTraits    Json?    @map("suggested_traits")
  suggestedIdeals    Json?    @map("suggested_ideals")
  suggestedBonds     Json?    @map("suggested_bonds")
  suggestedFlaws     Json?    @map("suggested_flaws")
  page               Int?
  createdAt          DateTime @default(now())

  characters          Character[]
  backgroundLanguages BackgroundLanguage[]

  @@map("background")
}

model BackgroundLanguage {
  backgroundId String
  languageId   String
  background   Background @relation(fields: [backgroundId], references: [id], onDelete: Cascade)
  language     Language   @relation(fields: [languageId], references: [id])

  @@id([backgroundId, languageId])
  @@map("background_language")
}

model Feat {
  id             String   @id @default(uuid())
  name           String   @unique
  source         String
  prerequisite   Json?
  abilityBonuses Json?    @map("ability_bonuses")
  description    Json
  page           Int?
  createdAt      DateTime @default(now())

  @@map("feat")
}

model Deity {
  id          String   @id @default(uuid())
  name        String
  source      String
  pantheon    String?
  alignment   String?
  domains     Json?
  symbol      String?
  description Json?
  page        Int?
  createdAt   DateTime @default(now())

  @@unique([name, source])
  @@map("deity")
}

model Item {
  id                    String   @id @default(uuid())
  name                  String
  source                String
  type                  String // primary category: weapon, armor, potion, wondrous item, ...
  types                 String[] @default([]) // all categories, e.g. ["weapon", "magic item"]
  subtype               String?
  armorType             String?  @map("armor_type") // light, medium, heavy, shield
  weaponType            String?  @map("weapon_type") // melee, ranged
  weaponCategory        String?  @map("weapon_category") // simple, martial
  rarity                String?
  attunement            Boolean  @default(false)
  attunementRequirement String?  @map("attunement_requirement") // e.g. "by a Dwarf"
  value                 String? // original text, e.g. "10gp"
  valueGp               Float?   @map("value_gp") // normalized gold value
  valueEstimated        Boolean  @default(false) @map("value_estimated") // valueGp derived from rarity guidelines
  weight                Float?
  damage                String?
  damageType            String?  @map("damage_type")
  armorClass            Int?     @map("armor_class")
  strengthRequirement   Int?     @map("strength_requirement")
  stealthDisadvantage   Boolean  @default(false) @map("stealth_disadvantage")
  description           Json?
  page                  Int?
  createdAt             DateTime @default(now())

  characterItems CharacterItem[]
  users          ItemToUser[]
  encounterLoot  EncounterLoot[]

  @@unique([name, source])
  @@map("item")
}

// ============================================================================
// MONSTERS
// ============================================================================

model MonsterType {
  id   String @id @default(uuid())
  name String @unique

  monsters Monster[]

  @@map("monster_type")
}

model Monster {
  id                    String   @id @default(uuid())
  name                  String
  source                String
  size                  String
  typeId                String   @map("type_id")
  tags                  Json?
  alignment             Json?
  armorClass            Int?     @map("armor_class")
  armorType             String?  @map("armor_type")
  hitPointsAvg          Int?     @map("hit_points_avg")
  hitPointsFormula      String?  @map("hit_points_formula")
  speedWalk             Int?     @map("speed_walk")
  speedFly              Int?     @map("speed_fly")
  speedSwim             Int?     @map("speed_swim")
  speedClimb            Int?     @map("speed_climb")
  speedBurrow           Int?     @map("speed_burrow")
  strScore              Int?     @map("str_score")
  dexScore              Int?     @map("dex_score")
  conScore              Int?     @map("con_score")
  intScore              Int?     @map("int_score")
  wisScore              Int?     @map("wis_score")
  chaScore              Int?     @map("cha_score")
  strSave               Int?     @map("str_save")
  dexSave               Int?     @map("dex_save")
  conSave               Int?     @map("con_save")
  intSave               Int?     @map("int_save")
  wisSave               Int?     @map("wis_save")
  chaSave               Int?     @map("cha_save")
  skills                Json?
  damageVulnerabilities Json?    @map("damage_vulnerabilities")
  damageResistances     Json?    @map("damage_resistances")
  damageImmunities      Json?    @map("damage_immunities")
  conditionImmunities   Json?    @map("condition_immunities")
  senses                String?
  passivePerception     Int?     @map("passive_perception")
  languages             String?
  challengeRating       String   @map("challenge_rating")
  crValue               Float?   @map("cr_value")
  page                  Int?
  createdAt             DateTime @default(now())

  monsterType MonsterType        @relation(fields: [typeId], references: [id])
  traits      MonsterTrait[]
  actions     MonsterAction[]
  spells      MonsterSpell[]
  encounters  EncounterMonster[]
  npcs        Npc[]
  users       MonsterToUser[]

  @@unique([name, source])
  @@map("monster")
}

model MonsterSpell {
  id        String  @id @default(uuid())
  monsterId String  @map("monster_id")
  spellId   String  @map("spell_id")
  monster   Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  spell     Spell   @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@unique([monsterId, spellId])
  @@map("monster_spell")
}

model MonsterTrait {
  id          String   @id @default(uuid())
  monsterId   String
  name        String
  description Json
  createdAt   DateTime @default(now())

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@map("monster_trait")
}

model MonsterAction {
  id          String   @id @default(uuid())
  monsterId   String
  name        String
  type        String   @default("action")
  description Json
  createdAt   DateTime @default(now())

  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@map("monster_action")
}

// ============================================================================
// USER CONTENT
// ============================================================================

model Party {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters Character[]
  encounters Encounter[]

  @@index([userId])
  @@map("party")
}

model Character {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  partyId              String?
  name                 String
  playerName           String?  @map("player_name")
  level                Int      @default(1)
  raceId               String?
  subraceId            String?
  classId              String?
  subclassId           String?
  backgroundId         String?
  armorClass           Int?     @map("armor_class")
  currentHp            Int?
  maxHp                Int?     @map("max_hp")
  tempHp               Int      @default(0) @map("temp_hp")
  proficiencyBonus     Int?     @map("proficiency_bonus")
  experiencePoints     Int      @default(0) @map("experience_points")
  strScore             Int      @default(10) @map("str_score")
  dexScore             Int      @default(10) @map("dex_score")
  conScore             Int      @default(10) @map("con_score")
  intScore             Int      @default(10) @map("int_score")
  wisScore             Int      @default(10) @map("wis_score")
  chaScore             Int      @default(10) @map("cha_score")
  passivePerception    Int?     @map("passive_perception")
  passiveInvestigation Int?     @map("passive_investigation")
  passiveInsight       Int?     @map("passive_insight")
  inspiration          Boolean  @default(false)
  imageUrl             String?  @map("image_url")
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  party      Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  race       Race?              @relation(fields: [raceId], references: [id])
  subrace    Subrace?           @relation(fields: [subraceId], references: [id])
  class      Class?             @relation(fields: [classId], references: [id])
  subclass   Subclass?          @relation(fields: [subclassId], references: [id])
  background Background?        @relation(fields: [backgroundId], references: [id])
  spells     CharacterSpell[]
  features   CharacterFeature[]
  items      CharacterItem[]

  @@index([userId])
  @@map("character")
}

model CharacterSpell {
  id          String   @id @default(uuid())
  characterId String
  spellId     String
  prepared    Boolean  @default(false)
  usedPerDay  Int?     @map("used_per_day")
  createdAt   DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  spell     Spell     @relation(fields: [spellId], references: [id], onDelete: Cascade)

  @@unique([characterId, spellId])
  @@map("character_spell")
}

model CharacterFeature {
  id            String   @id @default(uuid())
  characterId   String
  featureName   String
  description   String?
  usesRemaining Int?     @map("uses_remaining")
  maxUses       Int?     @map("max_uses")
  createdAt     DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_feature")
}

model CharacterItem {
  id          String   @id @default(uuid())
  characterId String
  itemId      String?
  customName  String?  @map("custom_name")
  quantity    Int      @default(1)
  equipped    Boolean  @default(false)
  attuned     Boolean  @default(false)
  createdAt   DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item      Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("character_item")
}

model Encounter {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  partyId     String?  @map("party_id")
  name        String
  description String?
  notes       String?
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  party    Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  monsters EncounterMonster[]
  loot     EncounterLoot[]

  @@index([userId])
  @@map("encounter")
}

model EncounterMonster {
  id          String  @id @default(uuid())
  encounterId String
  monsterId   String
  quantity    Int     @default(1)
  initiative  Int?
  currentHp   Int?    @map("current_hp")
  maxHp       Int?    @map("max_hp")
  conditions  Json?
  isActive    Boolean @default(true) @map("is_active")
  notes       String?

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  monster   Monster   @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@unique([encounterId, monsterId])
  @@map("encounter_monster")
}

model EncounterLoot {
  id          String   @id @default(uuid())
  encounterId String
  itemId      String?
  customName  String?  @map("custom_name")
  quantity    Int      @default(1)
  valueGp     Float?   @map("value_gp")
  notes       String?
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  item      Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

