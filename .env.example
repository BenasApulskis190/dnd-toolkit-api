# Database connection
DATABASE_URL="postgresql://appuser:apppassword@localhost:5432/dnndb"

# Server
NODE_ENV=development
PORT=3000

# Comma-separated list of origins allowed to send credentialed (cookie) requests
CLIENT_ORIGIN=http://localhost,http://dnd.dev,http://localhost:5173

# Google OAuth (Sign in with Google) - Client ID only, no secret needed for ID token verification
GOOGLE_CLIENT_ID=
